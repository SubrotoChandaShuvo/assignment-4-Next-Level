enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  password     String
  phone        String?
  profileImage String?

  role         Role         @default(CUSTOMER)
  status       UserStatus   @default(ACTIVE)

  gearItems    GearItem[]
  rentals      RentalOrder[]
  reviews      Review[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}